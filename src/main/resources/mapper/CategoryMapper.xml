<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.CategoryMapper">

    <insert id="addCategory" parameterType="category">
        INSERT INTO category
                (CATEGORY_NAME,LEVEL,PARENT_ID,CREATE_TIME,IS_DELETE)
            VALUES
                (#{categoryName},#{level},#{parentId},#{createTime},#{isDelete})
    </insert>

    <select id="getCategoryList" resultType="category">
        SELECT * FROM category ORDER BY PARENT_ID ASC,CATEGORY_ID ASC
    </select>
    
    <select id="getCategory" resultType="category">
        SELECT * FROM category WHERE CATEGORY_ID=#{categoryId}
    </select>
    
    <update id="updateCategory" parameterType="category">
        UPDATE category
        <set>
            <if test="categoryName!=null">CATEGORY_NAME=#{categoryName},</if>
            <if test="level!=null">LEVEL=#{level},</if>
            <if test="parentId!=null">PARENT_ID=#{parentId},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        <where>
            <if test="categoryId!=null">CATEGORY_ID=#{categoryId}</if>
        </where>
    </update>

</mapper>