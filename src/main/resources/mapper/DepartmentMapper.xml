<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.DepartmentMapper">

    <insert id="addDepartment" parameterType="department">
        INSERT INTO department(
                               DEPT_NAME,`LEVEL`,PARENT_ID,CREATE_TIME,IS_DELETE)
                       VALUES (#{deptName},#{level},#{parentId},#{createTime},#{isDelete})
    </insert>

    <update id="updateDepartment" parameterType="department">
        UPDATE department
        <set>
            <if test="deptName!=null">DEPT_NAME=#{deptName},</if>
            <if test="level!=null">LEVEL=#{level},</if>
            <if test="parentId!=null">PARENT_ID=#{parentId},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        <where>
            dept_id=#{deptId}
        </where>
    </update>

    <select id="getDepartmentList" resultType="department">
        SELECT * FROM department ORDER BY PARENT_ID ASC,DEPT_ID ASC
    </select>
    
    <select id="getDepartmentListByDeptId" parameterType="int" resultType="department">
        SELECT * FROM department WHERE IS_DELETE=1 AND PARENT_ID=#{deptId}
    </select>

    <update id="deleteDepartment" parameterType="int">
        UPDATE department SET IS_DELETE=0 WHERE dept_id=#{deptId}
    </update>

</mapper>