<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.LevelMapper">

    <insert id="addLevel" parameterType="level">
        INSERT INTO level(LEVEL_NAME,CREATE_TIME,IS_DELETE) VALUES (#{levelName},#{createTime},#{isDelete})
    </insert>
    
    <select id="getLevelList" resultType="level">
        SELECT * FROM level
    </select>
    
    <select id="getLevel" parameterType="int" resultType="level">
        SELECT * FROM level WHERE LEVEL_ID=#{levelId}
    </select>
    
    <update id="deleteLevel" parameterType="int">
        UPDATE level SET IS_DELETE=0 WHERE level_id=#{levelId}
    </update>

    <update id="updateLevel" parameterType="level">
        UPDATE level
        <set>
            <if test="levelName!=null">LEVEL_NAME=#{levelName},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        <where>
            <if test="levelId!=null">LEVEL_ID=#{levelId}</if>
        </where>
    </update>


    <update id="batchDeleteLevel" parameterType="int">
        <foreach collection="list" item="item" separator=";">
            UPDATE level SET IS_DELETE=0 WHERE level_id=#{item}
        </foreach>
    </update>

</mapper>