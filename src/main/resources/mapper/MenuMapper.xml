<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.MenuMapper">

    <insert id="addMenu" parameterType="menu">
        INSERT INTO
            menus(
                 MENU_NAME,MENU_URL,`LEVEL`,
                 PARENT_ID,CREATE_TIME,IS_DELETE
                 )
            VALUES(
                   #{menuName},#{menuUrl},#{level},
                   #{parentId},#{createTime},#{isDelete}
                  )
    </insert>
    
    <update id="updateMenu" parameterType="menu">
        UPDATE menus
        <set>
            <if test="menuName!=null">MENU_NAME=#{menuName},</if>
            <if test="menuUrl!=null">MENU_URL=#{menuUrl},</if>
            <if test="level!=null">LEVEL=#{level},</if>
            <if test="parentId!=null">PARENT_ID=#{parentId},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        <where>
            MENU_ID=#{menuId}
        </where>
    </update>
    
    <update id="deleteMenu" parameterType="int">
        UPDATE menus SET IS_DELETE=0 WHERE  MENU_ID=#{menuId}
    </update>

    <select id="getMenuList" resultType="menu">
        SELECT * FROM menus ORDER BY PARENT_ID ASC,MENU_ID ASC
    </select>

    <!--
        带层级获取菜单列表
    -->
    <resultMap id="menuMap" type="menu">
        <id column="MENU_ID" property="menuId"></id>
        <result column="MENU_NAME" property="menuName"></result>
        <result column="MENU_URL" property="menuUrl"></result>
        <result column="LEVEL" property="level"></result>
        <result column="PARENT_ID" property="parentId"></result>
        <result column="CREATE_TIME" property="createTime"></result>
        <result column="UPDATE_TIME" property="updateTime"></result>
        <result column="IS_DELETE" property="isDelete"></result>
        <collection property="menus" column="MENU_ID" select="io.ukoko.bhwms.mapper.MenuMapper.getMenusByMenuId"></collection>
    </resultMap>
    <select id="getMenuList$" resultMap="menuMap">
        SELECT * FROM menus WHERE PARENT_ID=0 ORDER BY PARENT_ID ASC,MENU_ID ASC
    </select>


    <select id="getMenusByMenuId" resultType="menu" parameterType="int">
        SELECT * FROM menus WHERE IS_DELETE=1 AND PARENT_ID=#{menuId}
    </select>
    
</mapper>