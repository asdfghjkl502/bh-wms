<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.RecordStockMapper">

    <insert id="addRecordStock" parameterType="recordStock">
        INSERT INTO
            record_stock
                (PRODUCT_ID,REPO_ID,PRODUCT_STOCK,CREATE_TIME,IS_DELETE)
            VALUES
                (#{productId},#{repoId},#{productStock},#{createTime},#{isDelete})
    </insert>
    
    <update id="inRecordStock" parameterType="recordStock">
        UPDATE record_stock 
        <set>
            <if test="productStock!=null">PRODUCT_STOCK=PRODUCT_STOCK+#{productStock},</if>
        </set>
        WHERE PRODUCT_ID=#{productId} AND REPO_ID=#{repoId}
    </update>

    <update id="outRecordStock" parameterType="recordStock">
        UPDATE record_stock
        <set>
            <if test="productStock!=null">PRODUCT_STOCK=PRODUCT_STOCK-#{productStock},</if>
        </set>
        WHERE PRODUCT_ID=#{productId} AND REPO_ID=#{repoId}
    </update>

    <resultMap id="recordStockMap" type="recordStock">
        <id column="PRODUCT_ID" property="productId"></id>
        <id column="REPO_ID" property="repoId"></id>
        <result column="PRODUCT_STOCK" property="productStock"></result>
        <result column="CREATE_TIME" property="createTime"></result>
        <result column="UPDATE_TIME" property="updateTime"></result>
        <result column="IS_DELETE" property="isDelete"></result>
        <!-- 关联查询仓库 -->
        <association property="repository" column="REPO_ID" select="io.ukoko.bhwms.mapper.RepositoryMapper.getRepositorybyRepoId"></association>
        <!-- 关联查询产品 -->
        <association property="product" column="PRODUCT_ID" select="io.ukoko.bhwms.mapper.ProductMapper.getProductByProductId"></association>
    </resultMap>

    <select id="getRecordStockList" resultMap="recordStockMap">
        SELECT * FROM record_stock
        <where>
            <if test="productId!=null">PRODUCT_ID=#{productId}</if>
            <if test="repoId!=null">AND REPO_ID=#{repoId}</if>
        </where>
    </select>

</mapper>