<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.RoleMapper">

    <!--  添加角色  -->
    <insert id="addRole" parameterType="role" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO role(ROLE_NAME,CREATE_TIME,IS_DELETE) VALUES(#{roleName},#{createTime},#{isDelete})
    </insert>
    <!--  删除角色  -->
    <update id="deleteRole" parameterType="int">
        UPDATE role SET IS_DELETE=0 WHERE ROLE_ID=#{roleId}
    </update>
    <!--  更新角色  -->
    <update id="updateRole" parameterType="role">
        UPDATE role
        <set>
            <if test="roleName!=null">ROLE_NAME=#{roleName},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        WHERE ROLE_ID=#{roleId}
    </update>

    <!--查询单个-->
    <select id="getRoleByRoleId" resultType="role" parameterType="int">
        SELECT * FROM role WHERE ROLE_ID=#{roleId}
    </select>

    <!--批量删除-->
    <update id="batchDeleteRole">
        <foreach collection="list" item="item" separator=";">
            UPDATE role SET IS_DELETE=0 WHERE ROLE_ID=#{item}
        </foreach>
    </update>

    <!--查询列表-->
    <select id="getRoleList" resultType="role">
        SELECT * FROM role
        <where>
            <if test="roleName!=null">ROLE_NAME LIKE CONCAT('%',#{roleName},'%')</if>
            <if test="isDelete!=null">AND IS_DELETE=#{isDelete}</if>
            <if test="roleId!=null">AND ROLE_ID=#{roleId}</if>
            <if test="startTime!=null and endTime!=null">AND UPDATE_TIME <![CDATA[>=]]> #{startTime} AND UPDATE_TIME <![CDATA[<=]]> #{endTime}</if>
        </where>
    </select>

    <select id="getRoleByRoleName" resultType="role">
        SELECT * FROM role WHERE IS_DELETE=1 AND ROLE_NAME=#{roleName}
    </select>

</mapper>
