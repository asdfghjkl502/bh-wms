<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.RoleMapper">

    <!--  添加角色  -->
    <insert id="addRole" parameterType="role" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO role(ROLE_NAME,CREATE_TIME,IS_DELETE) VALUES(#{roleName},#{createTime},#{isDelete})
    </insert>
    <!--  删除角色  -->
    <update id="deleteRole" parameterType="int">
        UPDATE role SET IS_DELETE=0 WHERE ROLE_ID=#{roleId}
    </update>
    <!--  更新角色  -->
    <update id="updateRole" parameterType="role">
        UPDATE role
        <set>
            <if test="roleName!=null">ROLE_NAME=#{roleName},</if>
            <if test="createTime!=null">CREATE_TIME=#{createTime},</if>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </set>
        WHERE ROLE_ID=#{roleId}
    </update>
    <!--  查询角色列表  -->
    <select id="getRoleList" resultType="role" parameterType="int">
        SELECT * FROM role
        <where>
            <if test="isDelete!=null">IS_DELETE=#{isDelete}</if>
        </where>
    </select>
    <!--  查询单个角色  -->
    <select id="getRoleBy" parameterType="int" resultType="role">
        SELECT * FROM role WHERE ROLE_ID=#{roleId}
    </select>

    <select id="getRoleListLike" resultType="role">
        SELECT * FROM role
            <where>
                <if test="isDelete!=null">IS_DELETE=#{isDelete} </if>
                <if test="roleName!=null">AND  ROLE_NAME LIKE CONCAT('%',#{roleName},'%')</if>
            </where>
    </select>
    
    <select id="getRolesByParam" resultType="role">
        SELECT * FROM role
        <where>
            <if test="isDelete!=null">IS_DELETE=#{isDelete} </if>
            <if test="roleName!=null">AND  ROLE_NAME LIKE CONCAT('%',#{roleName},'%')</if>
            <if test="startTime!=null and endTime!=null">
                AND CREATE_TIME  <![CDATA[>=]]>  #{startTime} AND CREATE_TIME <![CDATA[<=]]> #{endTime}
            </if>
        </where>
    </select>

</mapper>