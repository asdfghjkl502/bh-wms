<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.SysLogMapper">

    <insert id="addSysLog" parameterType="sysLog">
        INSERT INTO sys_log(
            `type`,ip_addr,method_name,
            method,nick_name,create_time) VALUES(
             #{type},#{ipAddr},#{methodName}
             ,#{method},#{nickName},#{createTime}
            )
    </insert>

    <select id="getSysLogList" resultType="sysLog">
        SELECT * FROM sys_log 
        <where>
            <if test="type!=null">type=#{type}</if>
            <if test="methodName!=null">AND method_name LIKE CONCAT('%',#{methodName},'%')</if>
            <if test="method!=null">AND method LIKE CONCAT('%',#{method},'%')</if>
            <if test="nickName!=null">AND nick_name LIKE CONCAT('%',#{nickName},'%')</if>
            <if test="start!=null and end!=null">AND create_time <![CDATA[ >= ]]> #{start} AND create_time <![CDATA[ <= ]]> #{end}</if>
        </where>
    </select>
    
</mapper>