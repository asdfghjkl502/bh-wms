<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.ukoko.bhwms.mapper.SysLogMapper">

    <insert id="addSysLog" parameterType="sysLog">
        INSERT INTO sys_log(
            `type`,ip_addr,method_name,
            method,nick_name,create_time) VALUES(
             #{type},#{ipAddr},#{methodName}
             ,#{method},#{nickName},#{createTime}
            )
    </insert>
    
</mapper>